rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId));
    }

    function boardDoc(classId, boardId) {
      return get(/databases/$(database)/documents/classes/$(classId)/boards/$(boardId));
    }

    function isAppOwner() {
      return signedIn()
        && request.auth.token.keys().hasAll(['email', 'email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'fyhung@twghfwfts.edu.hk';
    }

    function isApprovedTeacher() {
      return isAppOwner() || (
        signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'teacher'
      );
    }

    function isClassOwner(classId) {
      return signedIn() && classDoc(classId).data.ownerUid == request.auth.uid;
    }

    function canManageClass(classId) {
      return isAppOwner() || (isApprovedTeacher() && isClassOwner(classId));
    }

    function canReadBoard(classId, boardId) {
      return signedIn() && boardDoc(classId, boardId).data.status in ['active', 'archived'];
    }

    match /users/{uid} {
      allow get, create, update: if signedIn() && request.auth.uid == uid;
      allow list: if isAppOwner();
      allow delete: if false;

      match /operations/{operationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.actorUid == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAppOwner());
      allow list, create, update, delete: if isAppOwner();
    }

    match /classes/{classId} {
      allow get: if signedIn();
      allow list: if isApprovedTeacher();
      allow create: if isApprovedTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if canManageClass(classId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canManageClass(classId);

      match /teacherInvites/{inviteId} {
        allow read, write: if false;
      }

      // Retained only so existing class membership records can be cleaned up.
      // The simplified model uses /staff and classes/{classId}.ownerUid.
      match /teachers/{teacherId} {
        allow read: if isApprovedTeacher();
        allow create, update: if false;
        allow delete: if canManageClass(classId)
          && !existsAfter(/databases/$(database)/documents/classes/$(classId));
      }

      match /boards/{boardId} {
        allow get, list: if signedIn();
        allow create, update, delete: if canManageClass(classId);

        match /sections/{sectionId} {
          allow get, list: if canReadBoard(classId, boardId);
          allow create, update, delete: if canManageClass(classId);
        }

        match /posts/{postId} {
          allow get, list: if canReadBoard(classId, boardId);
          allow create: if signedIn()
            && boardDoc(classId, boardId).data.status == 'active'
            && boardDoc(classId, boardId).data.allowPosting == true
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.caption is string
            && request.resource.data.caption.size() > 0
            && request.resource.data.caption.size() <= 500
            && request.resource.data.status == 'active'
            && exists(/databases/$(database)/documents/classes/$(classId)/boards/$(boardId)/sections/$(request.resource.data.sectionId));
          allow update: if canManageClass(classId);
          allow delete: if canManageClass(classId)
            || (signedIn() && resource.data.authorUid == request.auth.uid);
        }

        match /comments/{commentId} {
          allow get, list: if canReadBoard(classId, boardId);
          allow create: if signedIn()
            && boardDoc(classId, boardId).data.status == 'active'
            && boardDoc(classId, boardId).data.allowComments == true
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 500
            && request.resource.data.postId is string
            && exists(/databases/$(database)/documents/classes/$(classId)/boards/$(boardId)/posts/$(request.resource.data.postId));
          allow update: if false;
          allow delete: if canManageClass(classId);
        }
      }
    }
  }
}
